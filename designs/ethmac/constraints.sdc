set sdc_version 2.0

set_units -capacitance 1fF
set_units -time 1ps

# Set the current design
current_design ethmac

create_clock -name "wb_clk_i" -period 1000.0 -waveform {0.0 500.0} [get_ports wb_clk_i]
create_clock -name "vclk_wb_clk_i" -period 1000.0 -waveform {0.0 500.0} 
create_clock -name "mtx_clk_pad_i" -period 300.0 -waveform {0.0 150.0} [get_ports mtx_clk_pad_i]
