set_clock_groups -name "core_clock" -logically_exclusive -group [list \
  [get_clocks wb_clk_i]  \
  [get_clocks vclk_wb_clk_i] ] -group [list \
  [get_clocks mtx_clk_pad_i]  \
  [get_clocks vclk_mtx_clk_pad_i] ] -group [list \
  [get_clocks mrx_clk_pad_i]  \
  [get_clocks vclk_mrx_clk_pad_i] ]
